{
  "name": "magakura-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "禍蔵｜MAGAKURA 縦型ショート動画テンプレート (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "assets": "python3 scripts/generate-textures.py && node scripts/generate-audio.mjs",
    "render": "node scripts/render.mjs",
    "render:bgm": "node scripts/render.mjs --only=bgm",
    "render:nobgm": "node scripts/render.mjs --only=nobgm",
    "render:thumb": "node scripts/render.mjs --only=thumb",
    "check": "node scripts/check-output.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@remotion/bundler": "^4.0.533",
    "@remotion/cli": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
