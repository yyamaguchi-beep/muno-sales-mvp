# ============================================================
# GLOW WORKS 生野 GBP 自動投稿 — 環境設定
# cp .env.example .env して値を入れてください。.env は絶対に Git にコミットしないこと。
# ============================================================

# ---------- 実行モード ----------
# true: Google へ投稿しない (キャプション/画像/画像URL/投稿JSON/validation まで生成)。初回は必ず true。
DRY_RUN=true
# false: 生成した投稿を承認待ち (pending) で保存し、`npm run approve` で投稿 / true: 自動で投稿
AUTO_PUBLISH=false
# true: OpenAI を呼ばずにモック文章・画像で動作確認 (本番投稿は不可)
AI_MOCK=false

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_QUALITY_PRIORITY=true のとき使う高品質モデル
OPENAI_IMAGE_MODEL_HQ=gpt-image-2.5-sunburst
IMAGE_QUALITY_PRIORITY=false
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024
# 空欄なら gpt-6.1-sol。利用できない場合は OPENAI_TEXT_MODEL_FALLBACK に自動切替
OPENAI_TEXT_MODEL=
OPENAI_TEXT_MODEL_FALLBACK=gpt-5.5
# generate: 毎回新規生成 / edit: assets/reference/ の実写を元に編集 / auto: 参照写真があれば edit
IMAGE_MODE=auto
# 生成画像の破綻 (指・キーボード・文字) を AI でチェックし、NG なら1回再生成
IMAGE_VISION_CHECK=true
# 画像右下に「※画像はイメージです」を合成 (実在施設写真との誤認防止)
IMAGE_DISCLAIMER_LABEL=true
# 画像に短いフレーズ (例: 週1日から相談できます) を正確なフォントで合成することを許可
IMAGE_OVERLAY_TEXT=true

# ---------- Google OAuth / Business Profile ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_PORT=53682

# npm run find-location -- --write で自動設定されます
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# 誤投稿防止の照合条件 (Google 上の店舗名・住所と一致しないと投稿しない)
GBP_EXPECTED_NAME=GLOW WORKS 生野
GBP_EXPECTED_ADDRESS=大阪府大阪市生野区小路東5丁目12-19

WEBSITE_URL=https://glowworksikuno.com/

# ---------- 画像ストレージ (r2 | gcs | local) ----------
# local は動作確認専用 (Google から取得できないため本番投稿不可)
STORAGE_PROVIDER=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 例: https://pub-xxxxxxxx.r2.dev または https://img.example.com (末尾スラッシュ不要)
R2_PUBLIC_URL=

# GCS を使う場合
GCS_BUCKET=
GCS_PUBLIC_URL=
GCS_KEY_JSON_BASE64=

# SQLite 履歴 (data/posts.db) をストレージに保存・復元 (GitHub Actions では true)
STATE_SYNC=false

# ---------- スケジュール ----------
TIMEZONE=Asia/Tokyo
POST_HOUR=10
POST_MINUTE=30
# 予定時刻から N 分以上遅れた実行はスキップ (0 = 制限なし)
POST_WINDOW_MINUTES=0

# ---------- 品質基準 ----------
MIN_VALIDATION_SCORE=85
MIN_VALUE_SCORE=80
# 見学・相談導線 (LEARN_MORE ボタン) を付ける投稿の目安比率
CTA_RATIO=0.3
HISTORY_CONTEXT_POSTS=30
LOG_LEVEL=info
